# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.4.1"
synopsis: "OpenAPI-first OCaml DTO and server generator"
description:
  "Generates typed-endpoint DTOs and server bindings with shared types from dereferenced OpenAPI 3.0.3 or 3.2.1 JSON documents."
maintainer: ["Vladislav Prekel"]
authors: ["Vladislav Prekel"]
license: "MIT"
tags: ["http" "openapi" "codegen"]
homepage: "https://github.com/prekel/typed-endpoint"
bug-reports: "https://github.com/prekel/typed-endpoint/issues"
depends: [
  "dune" {>= "3.14"}
  "ocaml" {>= "4.14.1"}
  "typed-endpoint" {= version}
  "base"
  "yojson"
  "ppx_let" {>= "v0.16.0"}
  "typed-endpoint-ppx" {= version & with-test}
  "typed-endpoint-testing" {= version & with-test}
  "ppx_deriving_yojson" {with-test}
  "ppx_expect" {with-test}
  "ocamlformat" {= "0.29.0" & (with-test | with-dev-setup)}
  "ocaml-lsp-server" {with-dev-setup}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/prekel/typed-endpoint.git"
