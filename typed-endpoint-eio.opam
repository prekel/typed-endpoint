opam-version: "2.0"
version: "0.2.0"
synopsis: "Native Eio integration for typed-endpoint"
description:
  "A native cohttp-eio backend with routing for typed-endpoint declarations."
maintainer: ["Vladislav Prekel"]
authors: ["Vladislav Prekel"]
license: "MIT"
tags: ["http" "routing" "openapi" "eio"]
homepage: "https://github.com/prekel/typed-endpoint"
bug-reports: "https://github.com/prekel/typed-endpoint/issues"
depends: [
  "dune" {>= "3.14"}
  "ocaml" {>= "5.1.1"}
  "typed-endpoint" {= version}
  "typed-endpoint-testing" {= version & with-test}
  "base"
  "cohttp-eio" {= "6.3.0"}
  "eio" {>= "1.2"}
  "http"
  "uri"
  "yojson"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/prekel/typed-endpoint.git"
