{
  "openapi": "3.2.1",
  "info": {
    "title": "Admin API",
    "version": "1"
  },
  "paths": {
    "/v1/admin/pet": {
      "post": {
        "operationId": "savePet",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "x-name": "Pet",
                "x-id": "urn:shared:Pet",
                "additionalProperties": false,
                "required": [
                  "id",
                  "note"
                ],
                "properties": {
                  "id": {
                    "type": "integer"
                  },
                  "note": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "x-name": "Pet",
                  "x-id": "urn:shared:Pet",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "note"
                  ],
                  "properties": {
                    "id": {
                      "type": "integer"
                    },
                    "note": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "x-name": "Problem",
                  "x-id": "urn:shared:Problem"
                }
              }
            }
          },
          "413": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "x-name": "Problem",
                  "x-id": "urn:shared:Problem"
                }
              }
            }
          },
          "415": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "x-name": "Problem",
                  "x-id": "urn:shared:Problem"
                }
              }
            }
          }
        }
      }
    },
    "/probe": {
      "get": {
        "operationId": "probe",
        "responses": {
          "200": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "nothing",
                    "anything",
                    "score"
                  ],
                  "properties": {
                    "kind": {
                      "const": "ok"
                    },
                    "nothing": {
                      "type": "null"
                    },
                    "anything": true,
                    "score": {
                      "type": "number",
                      "exclusiveMinimum": 1,
                      "examples": [
                        2
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
