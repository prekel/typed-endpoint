depends: [
  "dune" {>= "3.14"}
  "ocaml" {>= "4.14.1"}
  "base"
  "yojson"
  "ppx_let" {>= "v0.16.0"}
  "ppx_deriving_yojson"
  "ocamlformat" {= "0.29.0" & with-dev-setup}
  "ocaml-lsp-server" {with-dev-setup}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/prekel/typed-endpoint.git"
