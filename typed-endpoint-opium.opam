# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.1"
synopsis: "Opium integration for typed-endpoint"
description:
  "An Opium backend that turns typed-endpoint declarations into an Opium application."
maintainer: ["Vladislav Prekel"]
authors: ["Vladislav Prekel"]
license: "MIT"
tags: ["http" "routing" "openapi" "opium"]
homepage: "https://github.com/prekel/typed-endpoint"
bug-reports: "https://github.com/prekel/typed-endpoint/issues"
depends: [
  "dune" {>= "3.14"}
  "ocaml" {>= "5.1.1"}
  "typed-endpoint" {= version}
  "typed-endpoint-testing" {= version & with-test}
  "base"
  "cohttp"
  "lwt"
  "opium" {= "0.18.0"}
  "uri"
  "yojson"
  "ppx_let" {>= "v0.17.1"}
  "ppx_deriving_yojson" {with-test}
  "ppx_deriving_jsonschema" {>= "0.0.8" & with-test}
  "ppx_expect" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/prekel/typed-endpoint.git"
